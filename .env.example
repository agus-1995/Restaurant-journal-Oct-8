# Copy to .env.local (git-ignored) and fill in. Leave both empty to run on local mock data.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "publishable" key (NOT the service_role / secret key, which must never be in a front end)
VITE_SUPABASE_ANON_KEY=
